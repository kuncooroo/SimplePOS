APP_NAME=SimplePOS
APP_ENV=local
APP_KEY=
# Production MUST set APP_DEBUG=false and APP_ENV=production
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SimplePOS MVP: MySQL. Do not use SQLite in production.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simplepos
DB_USERNAME=root
DB_PASSWORD=

# File session; HTTPS: SESSION_SECURE_COOKIE=true
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Store logo uploads use the public disk. Run once after install: php artisan storage:link

# Checkout must remain synchronous. Do not use redis/database workers for sales.
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Local development Owner (php artisan db:seed). Change before any real shop.
# Never commit a production password.
OWNER_NAME="Store Owner"
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=password

# Optional demo users for manual QA (php artisan db:seed --class=DemoSeeder)
DEMO_ADMIN_NAME="Store Administrator"
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=password
DEMO_CASHIER_NAME="Store Cashier"
DEMO_CASHIER_EMAIL=cashier@example.com
DEMO_CASHIER_PASSWORD=password
